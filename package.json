{
  "name": "pi-desktop",
  "private": false,
  "version": "0.8.3",
  "type": "module",
  "main": "dist/index.html",
  "description": "Pi desktop workspace — web dashboard, chat workspace, and usage summary extension for pi coding agent",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "dashboard",
    "configuration",
    "web-ui"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "node --check src/usage.js && node --check extensions/pi-usage-summary.js"
  },
  "files": [
    "pi-package",
    "server",
    "src",
    "extensions",
    "public",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "README.md",
    "README.zh-CN.md",
    "README.ja.md"
  ],
  "pi": {
    "extensions": [
      "./pi-package/index.ts",
      "./extensions/pi-usage-summary.js"
    ],
    "skills": [
      "./pi-package/skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "lucide-react": "^0.487.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.5.0",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.8.3",
    "undici": "^8.9.0",
    "vite": "^6.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "3.2.4"
  }
}
